# PostgreSQL Database Configuration
# Copy this file to .env and fill in your database credentials

DB_HOST=localhost
DB_PORT=5432
DB_NAME=airport_management_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=prefer

# Connection pool settings (optional)
DB_MIN_CONN=1
DB_MAX_CONN=10

# OpenSky Network Account (Optional - provides higher API rate limits for live ADS-B radar)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
